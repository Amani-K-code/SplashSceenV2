<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.splashscreencode.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">
            <action
                android:id="@+id/action_FirstFragment_to_SecondFragment"
                app:destination="@id/SecondFragment" />
            <action
                android:id="@+id/action_FirstFragment_to_ThirdFragment"
                app:destination="@id/ThirdFragment" />
            <action
                android:id="@+id/action_FirstFragment_to_ForthFragment"
                app:destination="@id/ForthFragment"/>
            <action
                android:id="@+id/action_FirstFragment_to_FifthFragment"
                app:destination="@id/FifthFragment" />
    </fragment>


    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.splashscreencode.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">
            <action
                android:id="@+id/action_SecondFragment_to_FirstFragment"
                app:destination="@id/FirstFragment" />
            <action
                android:id="@+id/action_SecondFragment_to_ThirdFragment"
                app:destination="@id/ThirdFragment" />
            <action
                android:id="@+id/action_SecondFragment_to_ForthFragment"
                app:destination="@id/ForthFragment" />
            <action
                android:id="@+id/action_SecondFragment_to_FifthFragment"
                app:destination="@id/FifthFragment"/>
    </fragment>

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.example.splashscreencode.ThirdFragment"
        android:label="Third Fragment"
        tools:layout="@layout/fragment_third">

            <action
                android:id="@+id/action_ThirdFragment_to_FirstFragment"
                app:destination="@id/FirstFragment" />
            <action
                android:id="@+id/action_ThirdFragment_to_SecondFragment"
                app:destination="@id/SecondFragment"  />
            <action
                android:id="@+id/action_ThirdFragment_to_ForthFragment"
                app:destination="@id/ForthFragment"/>
            <action
                android:id="@+id/action_ThirdFragment_to_FifthFragment"
                app:destination="@id/FifthFragment"/>

    </fragment>

    <fragment
        android:id="@+id/ForthFragment"
        android:name="com.example.splashscreencode.ForthFragment"
        android:label="Forth Fragment"
        tools:layout="@layout/fragment_forth">

            <action
                android:id="@+id/action_ForthFragment_to_FirstFragment"
                app:destination="@id/FirstFragment" />
            <action
                android:id="@+id/action_ForthFragment_to_SecondFragment"
                app:destination="@id/SecondFragment"  />
            <action
                android:id="@+id/action_ForthFragment_to_ThirdFragment"
                app:destination="@id/ThirdFragment"/>
            <action
                android:id="@+id/action_ForthFragment_to_FifthFragment"
                app:destination="@id/FifthFragment"/>

    </fragment>

    <fragment
        android:id="@+id/FifthFragment"
        android:name="com.example.splashscreencode.FifthFragment"
        android:label="Fifth Fragment"
        tools:layout="@layout/fragment_fifth">

            <action
                android:id="@+id/action_FifthFragment_to_FirstFragment"
                app:destination="@id/FirstFragment" />
            <action
                android:id="@+id/action_FifthFragment_to_SecondFragment"
                app:destination="@id/SecondFragment"  />
            <action
                android:id="@+id/action_FifthFragment_to_ThirdFragment"
                app:destination="@id/ThirdFragment"/>
            <action
                android:id="@+id/action_FifthFragment_to_ForthFragment"
                app:destination="@id/ForthFragment"/>

    </fragment>


</navigation>